# Store all project content in Git LFS (your existing setup)
Content/** filter=lfs diff=lfs merge=lfs -text

# Unreal binaries: LFS storage + LOCKABLE.
# 'lockable' makes these read-only until you claim them with `git lfs lock`,
# which is what stops two people overwriting the same Blueprint/level.
# (These also fix your previous lines, which were missing the leading '*'
#  and therefore matched nothing.)
*.uasset filter=lfs diff=lfs merge=lfs -text lockable
*.umap   filter=lfs diff=lfs merge=lfs -text lockable
