# Store all project content in Git LFS (objects live in Cloudflare R2)
Content/** filter=lfs diff=lfs merge=lfs -text

# Unreal binaries in LFS.
# NOTE: 'lockable' was removed. The Cloudflare R2 proxy backend does not
# implement the Git LFS locking API, so `git lfs lock/unlock` cannot work,
# and 'lockable' just leaves these files stuck read-only (Unreal can't save).
# We coordinate binary edits via level-per-area ownership + WhatsApp instead.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text
