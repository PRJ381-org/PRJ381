//Make an .env file with the below secrets. Replace the mongodb_uri string with the one in discord programming.
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prj381?retryWrites=true&w=majority
CORS_ORIGIN=*

// JWT_SECRET can be any random string (used to sign dashboard session tokens). Generate your own for local dev.
JWT_SECRET=<random-string>

// Microsoft sign-in (Entra ID) - leave blank until Chris shares the App Registration details.
MS_CLIENT_ID=
MS_TENANT_ID=

// Google Sheets (Open Day Feedback form responses) - from a Google Cloud service account.
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=